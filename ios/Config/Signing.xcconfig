// Committed signing config for the DeckCheck app target.
//
// Two settings here are *personal* — your Apple Developer Team ID and your bundle
// identifier (Apple requires the latter to be unique to you). Neither belongs in
// git, so both live in Local.xcconfig (this folder), which is git-ignored. Copy
// Local.xcconfig.example → Local.xcconfig and set them there.
//
// The defaults below apply when Local.xcconfig is absent or doesn't set them, so a
// fresh clone still opens and builds — Automatic signing just prompts you to pick a
// team once, and you change the bundle id in Xcode.
//
// This is what keeps DEVELOPMENT_TEAM and PRODUCT_BUNDLE_IDENTIFIER out of
// project.pbxproj, so your own settings never show up as an uncommitted diff and
// `git pull` never conflicts on them.

// Placeholder — override in Local.xcconfig (values there win, it's included last).
DECKCHECK_BUNDLE_ID = com.example.DeckCheck

#include? "Local.xcconfig"
